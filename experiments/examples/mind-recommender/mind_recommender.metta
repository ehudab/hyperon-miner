;;; ===========================================================================
;;; MIND frequency-based news recommender (PeTTa)
;;;
;;; Pipeline (run everything with one call at the bottom of this file):
;;;   1. filter-recommendation-patterns  keep (user-variable, article, article) patterns
;;;   2. compute-confidence              directed, smoothed confidence per article pair
;;;   3. to-cat / to-cat-2               lift article scores to category pairs (averaged)
;;;   4. score-impression                score every candidate from the user's history
;;;   5. process-impression / mean-auc   AUC per impression, then the mean
;;; ===========================================================================


;;; ---------------------------------------------------------------------------
;;; 0. DATA
;;; ---------------------------------------------------------------------------

!(import! &miner     input/miner)          ; pattern-miner output (TRAIN)
!(import! &behaviors input/behaviors)      ; behaviors used for counting (TRAIN)
!(import! &news      input/news)           ; (Catagory <article> <category>)

;; Impressions to evaluate (should come from DEV, not from the training data).
;; (Impression <impression-id> <user> <history> <clicked> <not-clicked>)
