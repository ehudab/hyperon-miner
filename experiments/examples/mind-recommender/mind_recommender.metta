;;; ---------------------------------------------------------------------------
;;; 1. SETTINGS
;;; ---------------------------------------------------------------------------
(= (cfg smoothing) 10)     ; lambda in conf = support / (count + lambda)
(= (cfg w-item) 0.7)       ; weight of the article-pair score
(= (cfg w-cat)  0.3)       ; weight of the category-pair score


;;; ---------------------------------------------------------------------------
;;; 2. SMALL HELPERS
;;; ---------------------------------------------------------------------------
(= (list-sum $list)
   (foldl-atom $list 0 $acc $x (+ $acc $x)))

(= (list-mean $list)
   (/ (list-sum $list) (size-atom $list)))

;; Number of distinct values of $var that satisfy the block $blk in $db.
(= (value-count $blk $var $db)
   (let* (($conj-blk     (union-atom (,) $blk))
          ($match-values (collapse (match $db $conj-blk $var)))
          ($ground-value (unique-atom $match-values)))
     (size-atom $ground-value)))

;; Category of an article, or `unknown` when news.metta has no entry for it
;; (without this fallback, a missing article silently drops the whole branch).
(= (category-of $news $article)
   (let $found (collapse (match $news (Catagory $article $cat) $cat))
        (if (== $found ()) unknown (car-atom $found))))


;;; ---------------------------------------------------------------------------
;;; 3. STAGE 1: filter mined patterns
;;; ---------------------------------------------------------------------------
(= (filter-recommendation-patterns $pattern-space $work)
   (match $pattern-space
     (supportOf (, (Clicked $user $article1) (Clicked $user $article2)) $support)
     (if (and (== (get-metatype $user) Variable)
              (not (or (== (get-metatype $article1) Variable)
                       (== (get-metatype $article2) Variable))))
         (add-atom $work
                   (proper-format $pattern-space
                                  (, (Clicked $user $article1) (Clicked $user $article2))
                                  $support)))))


;;; ---------------------------------------------------------------------------
;;; 4. STAGE 2: directed confidence between articles
;;; ---------------------------------------------------------------------------
;; Adds, for every surviving pair:
;;   (recommendation-score ((B A1) -> (B A2)) conf(A1->A2) jaccard)
;;   (recommendation-score ((B A2) -> (B A1)) conf(A2->A1) jaccard)
(= (compute-confidence $db_space $miner_space $work $lambda)
   (match $work
     (proper-format $miner_space
                    (, ($b1 $user $a1) ($b2 $user $a2))
                    $miner-support)
     (if (not (== $a1 $a2))                                   ; drop self-pairs
         (let* (($c1 (value-count (($b1 $user $a1)) $user $db_space))
                ($c2 (value-count (($b2 $user $a2)) $user $db_space))
                ($s  (value-count (($b1 $user $a1) ($b2 $user $a2)) $user $db_space)))
           (if (> $s 0)
               (let* (($conf1 (/ $s (+ $c1 $lambda)))         ; P(a2 | a1), smoothed
                      ($conf2 (/ $s (+ $c2 $lambda)))         ; P(a1 | a2), smoothed
                      ($jac   (/ $s (- (+ $c1 $c2) $s)))
                      ($ok1   (add-atom $work (recommendation-score (($b1 $a1) -> ($b2 $a2)) $conf1 $jac)))
                      ($ok2   (add-atom $work (recommendation-score (($b2 $a2) -> ($b1 $a1)) $conf2 $jac))))
                 ())
               (empty)))
         (empty))))


;;; ---------------------------------------------------------------------------
;;; 5. STAGE 3: category scores
;;; ---------------------------------------------------------------------------
;; 3a. every article-pair score becomes a (category -> category) score
(= (to-cat $news $work)
   (match $work
     (recommendation-score (($b1 $a1) -> ($b2 $a2)) $conf $jac)
     (let* (($cat1 (category-of $news $a1))
            ($cat2 (category-of $news $a2))
            ($ok   (add-atom $work (score-by-category ($cat1 -> $cat2) $conf))))
       ())))

;; 3b. average all scores that share the same (category -> category) pair
(= (to-cat-2 $work)
   (let* (($list   (eval (unique-atom (collapse (match $work
                                                  (score-by-category ($c1 -> $c2) $s1)
                                                  ($c1 -> $c2))))))
          (($cat1 -> $cat2) (superpose $list))
          ($scores (collapse (match $work (score-by-category ($cat1 -> $cat2) $s2) $s2)))
          ($avg    (list-mean $scores))
          ($ok     (add-atom $work (average-score-by-category ($cat1 -> $cat2) $avg))))
     ()))


;;; ---------------------------------------------------------------------------
;;; 6. STAGE 4: scoring candidates
;;; ---------------------------------------------------------------------------
;; Article-level confidence, 0 when the pair was never seen.
(= (item-conf $work $seen $cand)
   (let $found (collapse (match $work
                           (recommendation-score ((Clicked $seen) -> (Clicked $cand)) $c $j)
                           $c))
        (if (== $found ()) 0 (car-atom $found))))

;; Category-level score, 0 when the pair was never seen.
(= (cat-conf $work $seen-cat $cand-cat)
   (let $found (collapse (match $work
                           (average-score-by-category ($seen-cat -> $cand-cat) $s)
                           $s))
        (if (== $found ()) 0 (car-atom $found))))

;; Blended score of one (history article, candidate) pair.
(= (pair-score $work $news $seen $cand)
   (let* (($item (item-conf $work $seen $cand))
          ($cat  (cat-conf $work (category-of $news $seen) (category-of $news $cand))))
     (+ (* (cfg w-item) $item) (* (cfg w-cat) $cat))))

;; Candidate score = mean over the history (repeats count, so a user who read
;; 3 travel articles weighs travel 3x). Empty history -> 0 for every candidate.
(= (candidate-score $work $news $history $cand)
   (if (== $history ())
       0
       (/ (foldl-atom $history 0 $acc $seen
                      (+ $acc (pair-score $work $news $seen $cand)))
          (size-atom $history))))

;; Scores every candidate of one impression and stores
;; (Candidate_score <impression-id> <article> <score>)
(= (score-impression $work $news $imp $history $cands)
   (let* (($cand  (superpose $cands))
          ($score (candidate-score $work $news $history $cand))
          ($ok    (add-atom $work (Candidate_score $imp $cand $score))))
     ()))


;;; ---------------------------------------------------------------------------
;;; 7. STAGE 5: evaluation (AUC)
;;; ---------------------------------------------------------------------------
(= (cand-score $work $imp $cand)
   (let $found (collapse (match $work (Candidate_score $imp $cand $s) $s))
        (car-atom $found)))

;; clicked beats not-clicked = 1, tie = 0.5, loses = 0
(= (pair-credit $pos $neg)
   (if (> $pos $neg) 1 (if (== $pos $neg) 0.5 0)))

;; AUC of one impression. Returns nothing when there are no clicked or no
;; not-clicked candidates (AUC is undefined there), so the impression is skipped.
(= (impression-auc $work $imp $clicked $skipped)
   (let $pairs (* (size-atom $clicked) (size-atom $skipped))
        (if (== $pairs 0)
            (empty)
            (/ (foldl-atom $clicked 0 $acc1 $p
                           (+ $acc1
                              (foldl-atom $skipped 0 $acc2 $n
                                          (+ $acc2 (pair-credit (cand-score $work $imp $p)
                                                                (cand-score $work $imp $n))))))
               $pairs))))

;; Score one impression, then store its AUC.
(= (process-impression $imps $work $news)
   (match $imps
     (Impression $imp $user $history $clicked $skipped)
     (let* (($cands (union-atom $clicked $skipped))
            ($done  (collapse (score-impression $work $news $imp $history $cands)))
            ($auc   (impression-auc $work $imp $clicked $skipped))
            ($ok    (add-atom $work (Impression-auc $imp $auc))))
       ())))

(= (mean-auc $imps $work)
   (let* (($aucs  (collapse (match $work (Impression-auc $i $a) $a)))
          ($total (size-atom (collapse (match $imps (Impression $i $u $h $c $n) $i)))))
     (if (== $aucs ())
         (no-valid-impressions)
         (EVAL-RESULT (AUC (list-mean $aucs))
                      (valid-impressions (size-atom $aucs))
                      (total-impressions $total)))))


;;; ---------------------------------------------------------------------------
;;; 8. THE PIPELINE: one call runs every stage in order
;;; ---------------------------------------------------------------------------
;; $miner = pattern-miner output   $db = behaviors used for counting
;; $news  = article categories     $imps = space holding the Impression atoms
;; $work  = space where all derived atoms are written
;;
;; Each stage is wrapped in `collapse` so that it runs to completion exactly
;; once; without it, a stage that returns many results would re-run all the
;; stages after it once per result.
(= (run-pipeline $miner $db $news $imps $work)
   (let* (($s1 (collapse (filter-recommendation-patterns $miner $work)))
          ($s2 (collapse (compute-confidence $db $miner $work (cfg smoothing))))
          ($s3 (collapse (to-cat $news $work)))
          ($s4 (collapse (to-cat-2 $work)))
          ($s5 (collapse (process-impression $imps $work $news))))
     (mean-auc $imps $work)))


;;; ---------------------------------------------------------------------------
;;; RUN
;;; ---------------------------------------------------------------------------
!(run-pipeline &miner &behaviors &news &self &self)

;; Inspect everything that was derived:
;!(get-atoms &self)
